# Frontend settings (Vite reads VITE_* at build time). Copy to client/.env for local runs; on
# Vercel / Azure Static Web Apps set the same variables in the project settings.

# GeoSense API(s), in order of preference. The first one that answers is used; when it stops
# answering (e.g. the Azure app is stopped after its credits run out) the next one takes over.
VITE_API_URLS=http://localhost:8000
# e.g. VITE_API_URLS=https://geosense-api.azurewebsites.net,https://geosense-api.onrender.com

# Mapbox public token (pk.*), restricted to your site's URLs in the Mapbox account
VITE_MAPBOX_TOKEN=

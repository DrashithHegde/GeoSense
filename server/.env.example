# Copy to the repo-root .env (one level above server/)
API_HOST=127.0.0.1
API_PORT=8000
ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=geosense
DB_USER=postgres
DB_PASSWORD=

# Real data sources
OPENAQ_AQI_KEY=          # https://explore.openaq.org/register  (CPCB/MPCB stations via OpenAQ v3)
GEE_PROJECT=             # Google Earth Engine project for Sentinel-2 / Landsat

# Optional LLM for the explanation layer. First key found is used:
# ANTHROPIC_API_KEY -> GEMINI_API_KEY -> OPENAI_API_KEY. Without any key GeoSense
# returns the evidence-only (deterministic) explanation; nothing is invented.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=               # optional model override
# Optional fallback LLM (free key: console.groq.com/keys)
GROQ_API_KEY=
# AI use: summary = short checked plain-words summary + Ask GeoSense answers; off = no AI calls at all
AI_MODE=summary

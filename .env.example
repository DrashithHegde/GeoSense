# ── Copy this file to ".env" (same folder) and fill in the values ─────────────

# PostgreSQL / PostGIS (used by the backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geosense
DB_USER=postgres
DB_PASSWORD=geosense123

# Same values for the docker "db" container (docker compose reads these)
POSTGRES_DB=geosense
POSTGRES_USER=postgres
POSTGRES_PASSWORD=geosense123

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Real data sources
# free key: https://explore.openaq.org/register
OPENAQ_AQI_KEY=
# only needed to download NEW satellite rasters
GEE_PROJECT=

# Optional AI write-ups (first key found is used). Leave empty = evidence-only text.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# Frontend (copied into client/.env by setup.ps1)
VITE_API_URL=http://localhost:8000
# free token: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=
# Optional fallback LLM (free key: console.groq.com/keys)
GROQ_API_KEY=
# AI use: summary = short checked plain-words summary + Ask GeoSense answers; off = no AI calls at all
AI_MODE=summary
